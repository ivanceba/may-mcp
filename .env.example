# Example names only. Set these in the caller's environment; no automatic .env loading.
MAY_BASE_URL=https://may.example.invalid
MAY_API_KEY=replace-with-your-may-api-key
MAY_MCP_ALLOW_WRITES=false

# Required only for --transport http. One upstream May identity is shared by
# these explicitly enrolled OAuth subjects; whitespace separates subject IDs.
MAY_MCP_OAUTH_ISSUER=https://sso.example.invalid/realms/may
MAY_MCP_OAUTH_RESOURCE=https://mcp.example.invalid/mcp
MAY_MCP_OAUTH_JWKS_URL=https://sso.example.invalid/realms/may/protocol/openid-connect/certs
MAY_MCP_OAUTH_ALLOWED_SUBJECTS=replace-with-approved-subject-id
MAY_MCP_OAUTH_SCOPE=may:access
# Test-only exception: permits HTTP for numeric loopback hosts, never LAN/public.
MAY_MCP_OAUTH_ALLOW_LOOPBACK_HTTP=false
